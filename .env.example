# Apollo secrets. Copy to .env (chmod 600) and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Model provider (OpenAI-compatible). Mirrors the `commandcode` provider in kilo.json.
APOLLO_PROVIDER__BASE_URL=https://api.commandcode.ai/provider/v1
APOLLO_PROVIDER__API_KEY=replace-me
# Optional: a single chat model id used for every tier, and an embeddings model id.
# APOLLO_PROVIDER__CHAT_MODEL_ID=deepseek/deepseek-v4-flash-0731
# APOLLO_PROVIDER__EMBEDDING_MODEL_ID=openai/text-embedding-3-small

# Optional second OpenAI-compatible provider used only for /embeddings when the
# primary provider serves no embeddings model (fallback step 1).
# APOLLO_EMBEDDINGS__BASE_URL=
# APOLLO_EMBEDDINGS__API_KEY=

# Telegram bot token from BotFather.
APOLLO_TELEGRAM__BOT_TOKEN=replace-me

# Telegram numeric user id allowlist (comma-separated). Only these users are served.
APOLLO_TELEGRAM__ALLOWED_USER_IDS=

# Google Calendar MCP credentials (optional, v1.1 wiring).
# APOLLO_CALENDAR__CLIENT_ID=
# APOLLO_CALENDAR__CLIENT_SECRET=
# APOLLO_CALENDAR__REFRESH_TOKEN=
